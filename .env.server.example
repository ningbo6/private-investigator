# Copy to .env.server. Do not commit or share the filled file.
# DOMAIN is a DNS hostname only, without https:// or a path.
DOMAIN=detective.example.com
ACME_EMAIL=admin@example.com
AUTH_USER=detective
# Single quotes preserve the dollar signs of the bcrypt hash in Compose.
AUTH_PASSWORD_HASH=''
# Generate: python3 -c 'import secrets; print(secrets.token_hex(32))'
PROXY_TOKEN=
TENCENTCLOUD_WSA_APIKEY=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
